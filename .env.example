# FastAPI Server Configuration
PORT=8000
HOST=0.0.0.0

# Mahout Output Configuration
MAHOUT_RECOMMENDATIONS_PATH=output/mahout

# Last.fm 1K catalog generated by scripts/prepare_lastfm_dataset.py
DATASET_INTERACTIONS_PATH=dataset/lastfm/train_triplets.txt
SONG_MAPPING_PATH=dataset/lastfm/song_mapping.csv
USER_MAPPING_PATH=dataset/lastfm/user_mapping.csv
SONG_METADATA_PATH=dataset/lastfm/song_metadata.csv
MAHOUT_RECOMMENDATIONS_PATH=output/mahout-lastfm

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=music_recommendation

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
API_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Hadoop Cluster Configuration
HADOOP_NAMENODE_URI=hdfs://h-primary:9000
HDFS_INPUT_PATH=/music/input/train_triplets_1m.txt
HDFS_PROCESSED_PATH=/music/processed
HDFS_MAHOUT_INPUT=/music/mahout/input/mahout_input.csv
HDFS_MAHOUT_OUTPUT=/music/mahout/output

# Near-real-time event pipeline
STREAM_INPUT_DIR=streaming/input
STREAM_BRONZE_PATH=hdfs:///music/bronze/events
STREAM_SILVER_PATH=hdfs:///music/silver/events
STREAM_GOLD_PATH=hdfs:///music/gold/event_aggregates
STREAM_CHECKPOINT_PATH=hdfs:///music/checkpoints/events
KAFKA_BOOTSTRAP_SERVERS=
